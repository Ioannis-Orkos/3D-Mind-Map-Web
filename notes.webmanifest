{
  "id": "./",
  "name": "Mindspace Mind Map",
  "short_name": "Mind Map",
  "description": "Your personal 2D and 3D mind maps, notes and models.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101918",
  "theme_color": "#101918",
  "icons": [
    {
      "src": "./icons/app-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Notes",
      "short_name": "Notes",
      "description": "Choose a workspace and open its notes.",
      "url": "./?entry=notes",
      "icons": [
        {
          "src": "./icons/notes-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mind map",
      "short_name": "Mind map",
      "description": "Choose a workspace and open its map.",
      "url": "./?entry=map",
      "icons": [
        {
          "src": "./icons/app-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
